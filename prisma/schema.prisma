// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  engineType = "library"
}

model User {
  id                Int       @id @default(autoincrement())
  email             String    @unique
  password          String
  name              String?
  resetToken        String?
  resetTokenExpiry  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  auditLogs         AuditLog[]
  isSuperAdmin      Boolean   @default(false)
}

model GalleryImage {
  id        Int      @id @default(autoincrement())
  src       String
  category  String
  title     String?
  projectName String?
  createdAt DateTime @default(now())
}


model HeroSection {
  id              Int      @id @default(autoincrement())
  title           String
  subtitle        String?
  description     String?
  bgImageUrl      String?
  primaryBtnText  String?
  primaryBtnLink  String?
  secondaryBtnText String?
  secondaryBtnLink String?
  updatedAt       DateTime @updatedAt
}

model SectionContent {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  title     String?
  content   String
  updatedAt DateTime @updatedAt
}

model Service {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  icon        String?
  bgImage     String?
  createdAt   DateTime @default(now())
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String
  role      String?
  content   String
  avatar    String?
  createdAt DateTime @default(now())
}

model SiteSettings {
  id           Int      @id @default(autoincrement())
  navbarLinks  String
  footerText   String?
  socialLinks  String?
  contactEmail String?
  contactPhone String?
  contactAddress String?
  quickLinks   String?
  logo         String?
  headerLogo   String?
  headerLogoWidth String?
  headerLogoHeight String?
  footerLogo   String?
  footerLogoWidth String?
  footerLogoHeight String?
  favicon      String?
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String   // CREATE, UPDATE, DELETE, LOGIN
  entity    String   // User, Settings, Hero, etc.
  entityId  String?  // ID of the affected entity
  details   String?  // JSON string for details (before/after state)
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}
